{
  "name": "chainhint-mcp",
  "version": "1.4.1",
  "description": "ChainHint MCP server \u2014 crypto risk intelligence tools for Claude Desktop and Cursor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seomarlboro/chainhint-mcp.git"
  },
  "homepage": "https://chainhint.com/docs/api",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "chainhint-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crypto",
    "blockchain",
    "wallet",
    "risk",
    "aml",
    "sanctions",
    "forensics",
    "claude"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && node scripts/check-publish.mjs && node scripts/canon-check.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:publish": "npm run build && node scripts/check-publish.mjs",
    "canon:check": "npm run build && node scripts/canon-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
